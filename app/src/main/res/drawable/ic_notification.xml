<?xml version="1.0" encoding="utf-8"?>
<!-- Status bar notification icon. Must be a flat white silhouette on a transparent
     background — Android ignores the fill color on API 21+ and renders only the
     alpha shape, tinted to match the notification shade. Do not use the full-color
     launcher icon here (it renders as a solid blob in the status bar). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M4,4 H7.5 V20 H4 Z M16.5,4 H20 V20 H16.5 Z M4,10.5 H20 V13.5 H4 Z" />
</vector>

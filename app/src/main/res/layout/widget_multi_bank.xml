<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:letterSpacing="0.08"
            android:text="CONNECTED BANKS"
            android:textColor="#F59E0B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_total_balance_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total: ETB 0.00"
                android:textColor="#34D399"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_btn_refresh"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_stat_box_bg"
                android:contentDescription="Refresh"
                android:padding="3dp"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Bank Tile 1 & Tile 2 Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_stat_box_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="9dp">

            <TextView
                android:id="@+id/widget_bank_1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bank 1"
                android:textColor="#C084FC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_bank_1_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="ETB 0.00"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_stat_box_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="9dp">

            <TextView
                android:id="@+id/widget_bank_2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bank 2"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_bank_2_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="ETB 0.00"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bank Tile 3 & Tile 4 Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_stat_box_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="9dp">

            <TextView
                android:id="@+id/widget_bank_3_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bank 3"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_bank_3_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="ETB 0.00"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_stat_box_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="9dp">

            <TextView
                android:id="@+id/widget_bank_4_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bank 4"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_bank_4_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="ETB 0.00"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
